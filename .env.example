# ─── Nintendo eShop Radar ──────────────────────────────────────
# Copy this file to .env and fill in the values

# ─── Switch-Games.com (PRIMARY Data Source) ────────────────────
# Primary data source — aggregated multi-region game & price data.
#
# To obtain these values:
# 1. Open switch-games.com in your browser
# 2. Open Developer Tools (F12) → Network tab
# 3. Find requests to supabase.co
# 4. Extract the URL and apikey header value
#
SWITCH_GAMES_SUPABASE_URL=https://<project-ref>.supabase.co
SWITCH_GAMES_ANON_KEY=<your-anon-key>

# ─── Nintendo Official API (FALLBACK Source) ──────────────────
# Used when Switch-Games.com is unavailable or returns empty data.
#
# Country code for Nintendo eShop (default: TW)
COUNTRY=TW
# Language for price API responses (default: zh)
ESHOP_LANG=zh
# Nintendo HK/TW game catalog URL
# CATALOG_URL=https://www.nintendo.com/tw/data/json/switch_software.json
# Nintendo eShop Price API base URL
# PRICE_API_URL=https://api.ec.nintendo.com/v1/price

# ─── IGDB (Internet Game Database) ──────────────────────────
# Primary source for game cover images.
# Get your credentials from https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ─── OpenCritic (via RapidAPI) ───────────────────────────────
# Get your API key from https://rapidapi.com/opencritic-api/opencritic-api
OPENCRITIC_API_KEY=
# Max OpenCritic search calls per run (default: 10)
OPENCRITIC_SEARCH_LIMIT=10

# ─── Output ──────────────────────────────────────────────────
# Local data output directory (default: ../data)
# DATA_DIR=../data
